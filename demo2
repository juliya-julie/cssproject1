* {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    width: 100%;
    font-family: Arial, sans-serif;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: white;
}

a:hover {
    color: wheat;
}

button {
    background-color: rgb(3, 77, 77);
    border: none;
    min-height: 40px;
    padding: 10px 18px;
    border-radius: 5px;
    color: white;
    font-size: 15px;
    cursor: pointer;
}

button:hover {
    background-color: rgb(5, 100, 100);
}


/* ---------- PAGE 1: HOME ---------- */

.page1 {
    min-height: 100vh;
    background-image: url("home2.jpg");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 75px;
    padding: 10px 5%;
    background-color: rgb(3, 77, 77);
    position: relative;
    z-index: 10;
}

.Logo {
    width: 150px;
    height: 55px;
    object-fit: contain;
}

nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

nav a {
    font-size: 16px;
}

.icons {
    display: flex;
    align-items: center;
    gap: 15px;
}

.icon {
    color: wheat;
    font-size: 18px;
}

.icon:hover {
    color: white;
}

main {
    display: flex;
    width: 100%;
    min-height: calc(100vh - 75px);
}

.hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    width: 70%;
    padding: 40px 5%;
}

.hero h1 {
    color: rgb(3, 77, 77);
    font-size: clamp(36px, 5vw, 70px);
    line-height: 1.15;
    max-width: 750px;
}

.hero p {
    color: rgb(74, 73, 73);
    font-size: 18px;
    line-height: 1.6;
    max-width: 600px;
}


/* ---------- COMMON HEADINGS ---------- */

h2 {
    color: rgb(3, 77, 77);
    text-align: center;
    font-size: clamp(30px, 4vw, 50px);
    font-family: "Courier New", Courier, monospace;
    margin-bottom: 20px;
}


/* ---------- PAGE 2: ABOUT ---------- */

.page2 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 35px;
    min-height: 100vh;
    padding: 60px 5%;
    background-color: white;
}

.left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
    width: 50%;
}

.left h2 {
    align-self: center;
}

.left p {
    color: rgb(74, 73, 73);
    font-size: 15px;
    font-weight: normal;
    line-height: 1.7;
}

.left button {
    margin-top: 10px;
}

.right {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
}

.right img {
    width: 100%;
    max-width: 550px;
    height: auto;
    object-fit: cover;
    border-radius: 5px;
}


/* ---------- PAGE 3: SERVICES ---------- */

.page3 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 35px;
    min-height: 100vh;
    padding: 60px 5%;
    background-color: rgb(3, 77, 77);
}

.page3 h2 {
    color: wheat;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 30px;
    width: 100%;
    max-width: 1200px;
}

.card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 20px;
    border-radius: 8px;
    transition: background-color 0.3s ease;
}

.card:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.cards img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 5px;
}

.card h3 {
    color: whitesmoke;
    text-align: center;
    font-size: 25px;
}

.card p {
    color: whitesmoke;
    font-size: 14px;
    font-weight: normal;
    line-height: 1.7;
    text-align: center;
}

.card button {
    border: 2px solid wheat;
    color: wheat;
    background-color: transparent;
    margin-top: auto;
}

.card button:hover {
    background-color: wheat;
    color: rgb(3, 77, 77);
}


/* ---------- PAGE 4: CONTACT ---------- */

.page4 {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 25px;
    padding: 60px 5%;
    background-color: rgb(3, 44, 44);
}

.contact-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 50%;
    padding: 25px;
    background-color: #d3d3d3;
    border-radius: 5px;
}

.contact-info h2 {
    color: rgb(3, 44, 44);
}

.contact-info h3 {
    color: rgb(3, 44, 44);
    font-size: 18px;
    line-height: 1.5;
}

.contact-info-items {
    width: 100%;
}

.contact-info-item {
    display: flex;
    align-items: center;
    gap: 15px;
}

.contact-info-icons {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: rgb(3, 44, 44);
    color: white;
}

.contact-info-item a {
    color: rgb(3, 44, 44);
    overflow-wrap: anywhere;
}

.sml {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
}

.sml a {
    color: rgb(3, 44, 44);
    font-size: 22px;
}

.sml a:hover {
    color: rgb(3, 100, 100);
}

.contact-map {
    width: 100%;
}

iframe {
    display: block;
    width: 100%;
    height: 250px;
    border: 0;
    border-radius: 5px;
}


/* ---------- CONTACT FORM ---------- */

.contact-form {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
}

form {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
    padding: 30px;
    background-color: #d3d3d3;
    border-radius: 5px;
}

form h3 {
    color: rgb(3, 44, 44);
    font-size: 22px;
}

.row50 {
    display: flex;
    gap: 20px;
    width: 100%;
}

.input-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-width: 0;
}

label {
    color: rgb(3, 44, 44);
    font-size: 14px;
}

input {
    width: 100%;
    min-height: 42px;
    padding: 10px;
    border: 1px solid #999;
    border-radius: 4px;
    font-size: 14px;
}

input:focus,
textarea:focus {
    outline: 2px solid rgb(3, 77, 77);
    outline-offset: 1px;
}

.row100 {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

textarea {
    width: 100%;
    min-height: 150px;
    padding: 12px;
    border: 1px solid #999;
    border-radius: 4px;
    font-family: Arial, sans-serif;
    font-size: 14px;
    resize: vertical;
}

form button {
    width: 100px;
}


/* ---------- FOOTER ---------- */

footer {
    width: 100%;
}

footer .menu {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 180px;
    padding: 30px 5%;
    background-color: rgb(3, 77, 77);
}

footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.footer-divider {
    width: 100%;
    height: 1px;
    background-color: black;
}

.footer-copyright {
    color: wheat;
    font-size: 13px;
    font-weight: normal;
    text-align: center;
    line-height: 1.5;
}


/* ---------- TABLETS ---------- */

@media (max-width: 900px) {

    .hero {
        width: 85%;
    }

    .page2 {
        gap: 25px;
        padding: 50px 4%;
    }

    .left,
    .right {
        width: 50%;
    }

    .cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .page4 {
        gap: 20px;
        padding: 40px 3%;
    }

    .contact-info,
    .contact-form {
        width: 50%;
    }

    form {
        padding: 20px;
    }

    .row50 {
        gap: 15px;
    }
}


/* ---------- MOBILE PHONES ---------- */

@media (max-width: 600px) {

    header {
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 15px;
    }

    .Logo {
        width: 130px;
        height: 45px;
    }

    nav {
        gap: 12px;
    }

    nav a {
        font-size: 14px;
    }

    .icons {
        gap: 12px;
    }

    .page1 {
        min-height: 100vh;
        background-position: center;
    }

    main {
        min-height: calc(100vh - 130px);
    }

    .hero {
        justify-content: center;
        width: 100%;
        padding: 30px 20px;
        gap: 20px;
    }

    .hero h1 {
        font-size: clamp(34px, 9vw, 45px);
    }

    .hero p {
        font-size: 16px;
        line-height: 1.6;
    }

    .page2 {
        flex-direction: column;
        gap: 30px;
        padding: 45px 20px;
    }

    .left,
    .right {
        width: 100%;
    }

    .left {
        align-items: flex-start;
    }

    .left h2 {
        align-self: center;
        font-size: 35px;
    }

    .left p {
        font-size: 14px;
        line-height: 1.7;
    }

    .right img {
        width: 100%;
        height: auto;
    }

    .page3 {
        gap: 25px;
        padding: 45px 20px;
    }

    .page3 h2 {
        font-size: 35px;
    }

    .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .card {
        padding: 15px;
    }

    .card:hover {
        transform: none;
    }

    .cards img {
        height: 220px;
    }

    .card h3 {
        font-size: 22px;
    }

    .card p {
        font-size: 14px;
    }

    .page4 {
        flex-direction: column;
        gap: 25px;
        padding: 35px 15px;
    }

    .contact-info,
    .contact-form {
        width: 100%;
    }

    .contact-info {
        padding: 20px;
    }

    .contact-info h3 {
        font-size: 16px;
    }

    form {
        gap: 18px;
        padding: 20px;
    }

    form h3 {
        font-size: 20px;
    }

    .row50 {
        flex-direction: column;
        gap: 18px;
    }

    .input-box {
        width: 100%;
    }

    input,
    textarea {
        width: 100%;
    }

    iframe {
        height: 220px;
    }

    footer .menu {
        gap: 18px;
        padding: 25px 15px;
    }

    footer nav {
        gap: 15px;
    }

    .footer-copyright {
        font-size: 12px;
    }
}


/* ---------- VERY SMALL PHONES ---------- */

@media (max-width: 350px) {

    nav {
        gap: 9px;
    }

    nav a {
        font-size: 12px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .contact-info,
    form {
        padding: 15px;
    }

    .cards img {
        height: 180px;
    }
}